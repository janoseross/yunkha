{
  "expo": {
    "name": "yunkha",
    "slug": "yunkha",
    "scheme": "yunkha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/yunkha-icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "@config-plugins/react-native-webrtc",
      "expo-font",
      ["expo-splash-screen", {
        "backgroundColor": "#16211A",
        "image": "./assets/yunkha-splash.png",
        "imageWidth": 260,
        "resizeMode": "contain",
        "android": { "image": "./assets/yunkha-adaptive-foreground.png" }
      }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.eross.yunkha",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.eross.yunkha",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#16211A",
        "foregroundImage": "./assets/yunkha-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c97ca6fb-8bc1-4439-a6b8-96de3d6bd00a"
      }
    }
  }
}
